root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,props,targets,vcxproj,filters,vsconfig}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.sln]
charset = utf-8-bom
end_of_line = crlf
indent_style = tab

[*.{vcxproj,filters,props,targets}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
