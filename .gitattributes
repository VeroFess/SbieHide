# Normalize text deterministically. Visual Studio project containers retain CRLF.
* text=auto eol=lf

*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Common generated and packaged files are binary.
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.7z binary
*.zip binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
*.obj binary
