<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PlatformToolset>v145</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <CharacterSet>Unicode</CharacterSet>

    <SbieHideArtifactsRoot>$(MSBuildThisFileDirectory)artifacts\</SbieHideArtifactsRoot>
    <SbieHideBinRoot>$(SbieHideArtifactsRoot)bin\</SbieHideBinRoot>
    <SbieHideObjRoot>$(SbieHideArtifactsRoot)obj\</SbieHideObjRoot>
    <SbieHideLogsRoot>$(SbieHideArtifactsRoot)logs\</SbieHideLogsRoot>
    <SbieHideArtifactPlatform Condition="'$(Platform)' == 'Win32'">x86</SbieHideArtifactPlatform>
    <SbieHideArtifactPlatform Condition="'$(SbieHideArtifactPlatform)' == ''">$(Platform)</SbieHideArtifactPlatform>
    <OutDir>$(SbieHideBinRoot)$(SbieHideArtifactPlatform)\$(Configuration)\</OutDir>
    <IntDir>$(SbieHideObjRoot)$(MSBuildProjectName)\$(SbieHideArtifactPlatform)\$(Configuration)\</IntDir>
    <TLogLocation>$(IntDir)tlog\</TLogLocation>

    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
